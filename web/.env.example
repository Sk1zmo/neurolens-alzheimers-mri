# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and set the same keys in the Vercel
# project (Settings -> Environment Variables) for the deployment.
# ---------------------------------------------------------------------------

# Supabase — Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security and is used only in
# server-side route handlers. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret that unlocks /review, where uploaded scans are given the
# verified labels the retraining pipeline consumes. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVIEW_TOKEN=

# Local development only. `next dev` does not run Vercel's Python runtime, so
# point this at `python training/serve_local.py`. Leave it unset in production,
# where the relative /api/predict path hits the deployed function.
# NEXT_PUBLIC_PREDICT_URL=http://127.0.0.1:8000/api/predict
